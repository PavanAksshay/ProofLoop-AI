# Optional LLM investigator. Keep secrets out of Git.
# auto = Groq when GROQ_API_KEY is set, otherwise fallback unless Ollama URL is set.
# Set to groq, ollama, or fallback to choose explicitly.
PROOFLOOP_LLM_PROVIDER=auto
PROOFLOOP_LLM_TIMEOUT_SECONDS=12

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional override for compatible endpoints:
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Ollama (local)
# Set PROOFLOOP_LLM_PROVIDER=ollama to use this explicitly.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
