# Safe default: no external LLM provider or API key required.
PROOFLOOP_LLM_PROVIDER=fallback
PROOFLOOP_LLM_TIMEOUT_SECONDS=20

# Optional Groq provider:
# PROOFLOOP_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Optional local Ollama provider:
# PROOFLOOP_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# Optional override for the SQLite database path:
# PROOFLOOP_DB_PATH=./proofloop.db
